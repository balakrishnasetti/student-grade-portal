  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register teacher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Teacher\",\n  \"email\": \"teacher.postman@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"teacher\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                "const json = pm.response.json();",
                "pm.test('success is true', function () { pm.expect(json.success).to.eql(true); });",
                "pm.test('token is present', function () { pm.expect(json.data.token).to.be.a('string').and.not.empty; });",
                "pm.environment.set('token', json.data.token);"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
